rules_version = '2';

// Live Hard Tracker — Cloud Storage security rules
// Paste this entire file into: Firebase Console → Storage → Rules → Publish
//
// Each user can only read/write objects under /users/{uid}/photos/*.
// No other access is allowed.

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/photos/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
